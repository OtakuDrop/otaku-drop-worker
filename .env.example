# Supabase project settings (keep the service-role key server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_TABLE=merchandise_drops

# Apify Task polling is the preferred scheduled mode.
APIFY_TASK_ID=cAlUKJEgtVgsgxkEt
APIFY_API_TOKEN=replace-with-server-only-apify-token

# Legacy direct source toggles. Keep false unless separately authorized.
AMIAMI_ENABLED=false
MANDARAKE_ENABLED=false
SURUGAYA_ENABLED=false

# AmiAmi JSON API. The supplied endpoint requires authorized access.
AMIAMI_ENDPOINT=https://api.amiami.com/api/v1.0/items
AMIAMI_KEYWORDS=figure

# Mandarake public search document. Hidden JSON endpoints are not used.
MANDARAKE_ENDPOINT=https://search.mandarake.co.jp/search/search-results
MANDARAKE_KEYWORDS=figure
MANDARAKE_SORT=bid
MANDARAKE_CATEGORY=
MANDARAKE_BASE_URL=https://search.mandarake.co.jp/

# Suruga-ya public search document or documented regional equivalent.
SURUGAYA_ENDPOINT=https://www.suruga-ya.jp/search
SURUGAYA_KEYWORDS=figure
SURUGAYA_CATEGORY=
SURUGAYA_BASE_URL=https://www.suruga-ya.jp/

# Sync controls
RUN_ONCE=true
SYNC_INTERVAL_MINUTES=120
SOURCE_DELAY_MIN_SECONDS=30
SOURCE_DELAY_MAX_SECONDS=90
LOG_LEVEL=INFO
